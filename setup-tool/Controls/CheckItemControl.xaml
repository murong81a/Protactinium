<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ProtactiniumSetup.Controls.CheckItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12"
            Margin="0,0,0,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Ellipse x:Name="StatusDot"
                     Grid.Column="0"
                     Width="10" Height="10"
                     Margin="0,4,12,0"
                     VerticalAlignment="Top"
                     Fill="#0F7B0F" />

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="NameText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailText"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
                <TextBlock x:Name="WhyText"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
                <Border x:Name="HintBox"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4"
                        Padding="10,6"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="HintText" FontSize="12" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <StackPanel x:Name="Actions"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                <HyperlinkButton x:Name="DownloadLink" Content="获取" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
